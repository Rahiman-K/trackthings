# Server
PORT=3001
NODE_ENV=production
JWT_SECRET=change-this-to-a-random-long-string

# Google Calendar (optional - get from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.onrender.com/api/google/callback

# Frontend URL (for OAuth redirect)
FRONTEND_URL=https://your-domain.onrender.com
